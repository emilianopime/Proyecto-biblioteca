# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como ".env" y rellena los valores reales.
# El archivo ".env" real NO se sube al repositorio.
# ============================================================

# Clave secreta para firmar las sesiones de Flask.
# Genera una propia con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Credenciales del dashboard administrativo
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# Conexion a PostgreSQL
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_PORT=5432
